{
  "name": "truelist",
  "version": "1.0.0",
  "description": "Official Node.js SDK for the Truelist.io email validation API",
  "author": "Truelist <support@truelist.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Truelist-io-Email-Validation/truelist-node.git"
  },
  "homepage": "https://truelist.io",
  "keywords": [
    "email",
    "email-validation",
    "email-verification",
    "truelist",
    "email-checker",
    "disposable-email",
    "api"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
